<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gc_background"
    android:keepScreenOn="true">

    <!-- Preview fills screen; aspect handled by transform -->
    <com.opencv.camera.AutoFitTextureView
        android:id="@+id/texture_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.opencv.camera.CameraOverlayView
        android:id="@+id/camera_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/texture_view"
        app:layout_constraintEnd_toEndOf="@id/texture_view"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/texture_view"
        app:layout_constraintTop_toTopOf="@id/texture_view"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/focus_ring"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@drawable/bg_circle_button"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <View
        android:id="@+id/capture_flash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/gc_capture_flash"
        android:visibility="gone" />

    <TextView
        android:id="@+id/countdown_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:shadowColor="#80000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="8"
        android:textColor="@color/gc_primary"
        android:textSize="80sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="3" />

    <!-- Top gradient -->

    <!-- Top controls (padding applied via WindowInsets at runtime) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/top_gradient"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_top_gradient"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Left cluster: flash / timer / hdr tightly packed at the far left -->
        <LinearLayout
            android:id="@+id/top_left_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_flash"
                    style="@style/TopControlButton"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_flash_off"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/flash_label"
                    style="@style/TopControlLabel"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="@string/flash_off" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:layout_marginStart="2dp">

                <ImageView
                    android:id="@+id/btn_timer"
                    style="@style/TopControlButton"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_timer"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/timer_label"
                    style="@style/TopControlLabel"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="@string/timer_off" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="56dp"
                android:layout_marginStart="2dp">

                <ImageView
                    android:id="@+id/btn_hdr"
                    style="@style/TopControlButton"
                    android:layout_gravity="top|center_horizontal"
                    android:src="@drawable/ic_hdr_off"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/hdr_label"
                    style="@style/TopControlLabel"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="@string/hdr_auto" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btn_ai"
            style="@style/TopControlTextButton"
            android:background="@drawable/bg_ai_top_button"
            android:layout_width="wrap_content"
            android:minWidth="44dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="AI"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="0.5" />

        <LinearLayout
            android:id="@+id/top_right_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/aspect_ratio_button"
                style="@style/TopControlTextButton"
                android:text="FULL" />

            <ImageView
                android:id="@+id/btn_settings"
                style="@style/TopControlButton"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_settings"
                tools:ignore="ContentDescription" />
        </LinearLayout>

        <TextView
            android:id="@+id/iso_label"
            style="@style/TopControlLabel"
            android:text="ISO --"
            android:textColor="@color/gc_accent"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_ai" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Recording timer -->
    <LinearLayout
        android:id="@+id/recording_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_flash_options"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_recording_dot" />

        <TextView
            android:id="@+id/recording_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="00:00"
            android:textColor="@color/gc_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Bottom gradient -->
    <View
        android:id="@+id/bottom_gradient"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_bottom_gradient"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Mode selector: Photo / Portrait / Video / Pro -->
    <LinearLayout
        android:id="@+id/mode_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/mode_photo"
            style="@style/ModeSelectorText.Selected"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:padding="10dp"
            android:text="@string/mode_photo" />

        <TextView
            android:id="@+id/mode_portrait"
            style="@style/ModeSelectorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:padding="10dp"
            android:text="@string/mode_portrait" />

        <TextView
            android:id="@+id/mode_video"
            style="@style/ModeSelectorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="22dp"
            android:padding="10dp"
            android:text="@string/mode_video" />

        <TextView
            android:id="@+id/mode_pro"
            style="@style/ModeSelectorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:text="@string/mode_pro" />
    </LinearLayout>

    <View
        android:id="@+id/mode_indicator"
        android:layout_width="28dp"
        android:layout_height="3dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_mode_indicator"
        app:layout_constraintBottom_toTopOf="@id/mode_container"
        app:layout_constraintEnd_toEndOf="@id/mode_photo"
        app:layout_constraintStart_toStartOf="@id/mode_photo" />

    <!-- Zoom presets (1x / 2x / 5x) -->
    <LinearLayout
        android:id="@+id/zoom_presets"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/pro_panel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/zoom_preset_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:padding="4dp"
            android:text="1×"
            android:textColor="@color/gc_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/zoom_preset_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:padding="4dp"
            android:text="2×"
            android:textColor="@color/gc_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/zoom_preset_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:text="5×"
            android:textColor="@color/gc_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <!-- Bottom bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/thumbnail_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_thumbnail"
                android:clipToOutline="true"
                android:outlineProvider="background"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_gallery_placeholder"
                tools:ignore="ContentDescription" />

            <ProgressBar
                android:id="@+id/save_progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/gc_accent"
                android:visibility="gone" />
        </FrameLayout>

        <ImageView
            android:id="@+id/btn_shutter"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/selector_shutter"
            android:clickable="true"
            android:focusable="true"
            android:hapticFeedbackEnabled="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/btn_switch_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_button"
            android:padding="10dp"
            android:src="@drawable/ic_switch_camera"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Processing indicator -->
    <LinearLayout
        android:id="@+id/processing_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flash_options"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iso_label">

        <ProgressBar
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:indeterminateTint="@color/gc_accent" />

        <TextView
            android:id="@+id/processing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/capture_processing"
            android:textColor="@color/gc_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Zoom hint -->
    <TextView
        android:id="@+id/zoom_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_flash_options"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="1.0x"
        android:textColor="@color/gc_primary"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/zoom_presets"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Vertical EV slider (photo mode only) -->
    <com.opencv.camera.EvSliderView
        android:id="@+id/ev_slider"
        android:layout_width="44dp"
        android:layout_height="240dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/ev_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:text="@string/ev_0"
        android:textColor="@color/gc_primary"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/ev_slider"
        app:layout_constraintEnd_toStartOf="@id/ev_slider" />

    <!-- AE/AF lock hint -->
    <TextView
        android:id="@+id/ae_lock_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_flash_options"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/ae_af_locked"
        android:textColor="@color/gc_face_rect"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- Pro mode panel: histogram + manual chips + curved slider -->
    <LinearLayout
        android:id="@+id/pro_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_flash_options"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/mode_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.opencv.camera.HistogramView
            android:id="@+id/histogram_view"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp" />

        <LinearLayout
            android:id="@+id/pro_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pro_chip_iso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/pro_iso"
                android:textColor="@color/gc_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pro_chip_shutter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/pro_shutter"
                android:textColor="@color/gc_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pro_chip_ev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/pro_ev"
                android:textColor="@color/gc_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pro_chip_focus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/pro_focus"
                android:textColor="@color/gc_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/pro_chip_wb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="11dp"
                android:paddingTop="6dp"
                android:paddingEnd="11dp"
                android:paddingBottom="6dp"
                android:text="@string/pro_wb"
                android:textColor="@color/gc_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pro_slider_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.opencv.camera.ArcSliderView
                android:id="@+id/pro_arc"
                android:layout_width="56dp"
                android:layout_height="220dp" />

            <TextView
                android:id="@+id/pro_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:textColor="@color/gc_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pro_auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_flash_options"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/pro_auto"
                android:textColor="@color/gc_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
